# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git 에 올라가지 않는다. 키는 채팅·문서·로그 어디에도 적지 않는다.
# 노동통계국 (무료, 1분): https://data.bls.gov/registrationEngine/
BLS_API_KEY=
# 경제분석국 (무료): https://apps.bea.gov/api/signup/
BEA_API_KEY=
# 에너지정보청 (무료): https://www.eia.gov/opendata/register.php
EIA_API_KEY=
# 엔진 호출용. 둘 다 선불 충전식 — 소액만 충전하고 자동 충전은 끈다 (docs/12 §7)
# Claude: https://platform.claude.com/settings/keys  /  OpenAI: https://platform.openai.com/api-keys
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# --- 아래는 서버(EC2)에만 넣는다. 조종판과 SNS 게시 (docs/15 §6)
GOOGLE_SERVICE_ACCOUNT_FILE=
CONSOLE_SHEET_ID=
THREADS_APP_SECRET=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
